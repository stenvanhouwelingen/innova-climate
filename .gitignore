# Gitignore settings for ESPHome
# Build and temporary files
**/.esphome/
**/secrets.yaml

# OS and IDE files
**/.DS_Store
.vscode/
.idea/

# Python cache & tooling
**/__pycache__/
**/*.py[cod]
*$py.class
**/.ruff_cache/
**/.pytest_cache/

# Local reference manuals and scratch artifacts
*.pdf
manuals/
scratch/
